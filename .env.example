# Order delivery to Telegram via a free relay - NO server to deploy.
# Copy this file to ".env".
#
# Only the relay URL lives in this static site. The Telegram bot token stays
# inside the relay (Google Apps Script, see telegram-relay.gs), so it is never
# shipped to the browser. This is the secure-without-a-server setup.

# The Apps Script Web App URL: Deploy > New deployment > Web app, copy the
# URL ending in /exec.
VITE_ORDER_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbXXXXXXXX/exec

# Optional shared secret - must match SECRET inside the Apps Script.
# NOTE: VITE_ vars are bundled into the client, so this only deters casual
# spam, it is not a strong secret. The bot token (the real secret) stays in
# Apps Script and is never exposed.
VITE_ORDER_SECRET=doi-thanh-mot-chuoi-ngau-nhien
